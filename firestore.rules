rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        (
          ('email' in request.auth.token && (
             request.auth.token.email.lower() == "lbodysmodas01@gmail.com" || 
             request.auth.token.email.lower() == "vanessadgustarconfeitaria@admin.com"
          )) ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        );
    }

    function isValidMenuItem(data) {
      return data.name is string && data.name.size() > 0 &&
             data.category is string &&
             data.price is number && data.price >= 0;
    }

    function isValidPortfolioPost(data) {
      return data.imageUrl is string && data.createdAt is timestamp;
    }

    function isValidSettings(data) {
      // Allowed keys for settings could be dynamic, so we just return true.
      // Since only isAdmin() can write, this is safe.
      return true;
    }

    function isValidOrder(data) {
      return data.customerName is string && data.customerName.size() > 0 && data.customerName.size() < 100 &&
             data.customerPhone is string && data.customerPhone.size() > 0 &&
             data.items is list && data.items.size() > 0 &&
             data.total is number && data.total >= 0 &&
             data.status in ['pending', 'confirmed', 'delivered', 'cancelled'] &&
             data.createdAt is timestamp;
    }

    match /users/{userId} {
      allow read: if request.auth.uid == userId || isAdmin();
      allow create: if request.auth.uid == userId;
      allow update: if request.auth.uid == userId && (request.resource.data.role == resource.data.role) || isAdmin();
    }

    match /menu/{itemId} {
      allow read: if true;
      allow write: if isAdmin() && isValidMenuItem(request.resource.data);
    }

    match /portfolio/{postId} {
      allow read: if true;
      allow write: if isAdmin() && isValidPortfolioPost(request.resource.data);
    }

    match /orders/{orderId} {
      allow create: if isValidOrder(request.resource.data);
      allow read, update, delete: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin() && isValidSettings(request.resource.data);
    }
  }
}
